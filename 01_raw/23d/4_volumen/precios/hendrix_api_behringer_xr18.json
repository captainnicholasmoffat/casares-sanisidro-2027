[{"id":27270,"name":"CONSOLA DIGITAL BEHRINGER XR18","slug":"consola-digital-behringer-xr18","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hendrix.com.ar\/producto\/consola-digital-behringer-xr18\/","sku":"","short_description":"","description":"<h2 data-path-to-node=\"2\">BEHRINGER X AIR XR18<\/h2>\n<p data-path-to-node=\"3\">La Behringer XR18 es una mezcladora digital de <b data-path-to-node=\"3\" data-index-in-node=\"47\">18 canales<\/b> y 12 buses, dise\u00f1ada para ser controlada de forma inal\u00e1mbrica a trav\u00e9s de tablets (iPad\/Android) o computadoras (PC\/Mac\/Linux). Su integraci\u00f3n de previos Midas y una interfaz de audio multicanal la convierten en una herramienta extremadamente vers\u00e1til.<\/p>\n<h3 data-path-to-node=\"4\">Especificaciones T\u00e9cnicas<\/h3>\n<ul data-path-to-node=\"5\">\n<li>\n<p data-path-to-node=\"5,0,0\"><b data-path-to-node=\"5,0,0\" data-index-in-node=\"0\">Canales de Mezcla:<\/b> 18 canales de entrada (16 preamplificadores Midas programables + 2 entradas de l\u00ednea).<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"5,1,0\"><b data-path-to-node=\"5,1,0\" data-index-in-node=\"0\">Preamplificadores:<\/b> 16 conectores combo XLR\/TRS dise\u00f1ados por <b data-path-to-node=\"5,1,0\" data-index-in-node=\"61\">Midas<\/b>, conocidos por su transparencia y bajo ruido.<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"5,2,0\"><b data-path-to-node=\"5,2,0\" data-index-in-node=\"0\">Interfaz de Audio:<\/b> Interfaz USB 2.0 bidireccional de <b data-path-to-node=\"5,2,0\" data-index-in-node=\"53\">18 x 18 canales<\/b>, ideal para grabaci\u00f3n multipista directa a DAW.<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"5,3,0\"><b data-path-to-node=\"5,3,0\" data-index-in-node=\"0\">Procesamiento por Canal:<\/b><\/p>\n<ul data-path-to-node=\"5,3,1\">\n<li>\n<p data-path-to-node=\"5,3,1,0,0\">Puerta de ruido (Gate), Din\u00e1mica (Compresor).<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"5,3,1,1,0\">Ecualizador param\u00e9trico de 4 bandas.<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"5,3,1,2,0\">Analizador de espectro en tiempo real (RTA) de 100 bandas en todos los canales y buses.<\/p>\n<\/li>\n<\/ul>\n<\/li>\n<li>\n<p data-path-to-node=\"5,4,0\"><b data-path-to-node=\"5,4,0\" data-index-in-node=\"0\">Efectos (FX):<\/b> 4 ranuras de efectos est\u00e9reo que incluyen simulaciones de hardware legendario como Lexicon 480L, PCM70, EMT250 y Quantec QRS.<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"5,5,0\"><b data-path-to-node=\"5,5,0\" data-index-in-node=\"0\">Salidas:<\/b><\/p>\n<ul data-path-to-node=\"5,5,1\">\n<li>\n<p data-path-to-node=\"5,5,1,0,0\">2 salidas Main XLR.<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"5,5,1,1,0\">6 env\u00edos auxiliares (Aux Sends) en XLR para monitoreo personalizado.<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"5,5,1,2,0\">Salida de auriculares con control de nivel independiente.<\/p>\n<\/li>\n<\/ul>\n<\/li>\n<li>\n<p data-path-to-node=\"5,6,0\"><b data-path-to-node=\"5,6,0\" data-index-in-node=\"0\">Conectividad Inal\u00e1mbrica:<\/b> Router Wi-Fi tri-modo integrado (Access Point, Ethernet o Cliente Wi-Fi).<\/p>\n<\/li>\n<\/ul>","on_sale":false,"prices":{"price":"145010000","regular_price":"145010000","sale_price":"145010000","price_range":null,"currency_code":"ARS","currency_symbol":"$","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"$","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\">&#036;<\/span>1.450.100,00<\/span>","average_rating":"0","review_count":0,"images":[{"id":43208,"src":"https:\/\/hendrix.com.ar\/wp-content\/uploads\/2023\/11\/FUENTE-82.png","thumbnail":"https:\/\/hendrix.com.ar\/wp-content\/uploads\/2023\/11\/FUENTE-82-430x430.png","srcset":"https:\/\/hendrix.com.ar\/wp-content\/uploads\/2023\/11\/FUENTE-82.png 1080w, https:\/\/hendrix.com.ar\/wp-content\/uploads\/2023\/11\/FUENTE-82-300x300.png 300w, https